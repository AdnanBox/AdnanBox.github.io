---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-2 text-[var(--color-text-muted)]">This page doesn't exist.</p>
    <a href="/" class="mt-6 rounded-md bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-white hover:opacity-90">
      Back home
    </a>
  </div>
</BaseLayout>
