---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section class="mx-auto flex max-w-5xl flex-col items-center gap-8 px-4 py-16 text-center sm:px-6 sm:py-24 md:flex-row md:text-left">
    <img
      src={site.logo}
      alt={site.title}
      class="h-40 w-40 shrink-0 rounded-full border border-[var(--color-border)] object-cover sm:h-48 sm:w-48"
    />
    <div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{site.title}</h1>
      <p class="mt-2 text-lg text-[var(--color-text-muted)]">{site.subtitle}</p>
      <p class="mt-4 max-w-lg text-[var(--color-text-muted)]">{site.tagline}</p>

      <div class="mt-6 flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href="/projects"
          class="rounded-md bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-white hover:opacity-90"
        >
          View Projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
